# OSRM region name.
# Must match the folder name under data/ and the .osrm file prefix.
# Example: data/massachusetts/massachusetts-latest.osrm
OSRM_REGION=massachusetts

# Port exposed on localhost for the OSRM HTTP server.
OSRM_PORT=5002

# OpenRouteService API key (for check_distance_ors.py).
# Get a free key at https://openrouteservice.org/dev/#/signup
# Free tier: 2,000 requests/day, 40 requests/minute.
ORS_API_KEY=
